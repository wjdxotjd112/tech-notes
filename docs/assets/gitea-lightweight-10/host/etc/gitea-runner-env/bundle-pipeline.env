# root 소유. Secrets는 Workflow에서 전달한다.
source /etc/gitea-runner-env/services.env
NEXUS_URL="https://${SERVER_HOST}:${NEXUS_HTTPS_PORT}"
GITEA_URL="https://${SERVER_HOST}:${GITEA_HTTPS_PORT}"
GITEA_REPOSITORY=platform/private-cloud-v4
GITEA_REPO_URL="${GITEA_URL}/${GITEA_REPOSITORY}.git"
RELEASE_BRANCH=master
TEST_SKIP_LABEL=release:skip-test
# 신규 환경은 비운다. 승인 확인을 피하려고 새 Tag를 추가하지 않는다.
LEGACY_RELEASE_TAGS=""
NEXUS_USER=release-ci
PUBLIC_RELEASE_URL="https://${SERVER_HOST}:${RELEASE_HTTPS_PORT}"

BUNDLE_WORK_DIR=/data/private-release
RAW_CACHE_DIR=/data/private-release-cache/raw/sha256
BUNDLE_BUILDER_DIR=/opt/gitea/bundle-builder
NEXUS_BASE_IMAGE="${BUNDLE_BUILDER_DIR}/nexus3-3.96.1-image.tar"
TEMPLATE_DIR="${BUNDLE_BUILDER_DIR}/templates"
RELEASE_KEEP_COUNT=3

# 자체 서명 재현 구성. 사내 CA 신뢰 구성 후에는 false로 바꾼다.
TLS_SKIP_VERIFY=true
HTTP_CONNECT_TIMEOUT=10
HTTP_RETRY_COUNT=3
HAPROXY_MAP_FILE="${RELEASE_MAP_FILE}"
HAPROXY_SOCKET="${RELEASE_SOCKET}"

RUNNER_USER=gitea-runner
RUNNER_GROUP=gitea-runner
RUNNER_WORKSPACE=/var/lib/gitea-runner/workspace
TOFU_PROJECT_DIR=/var/lib/gitea-runner/opentofu/contrabass-packaging
TOFU_SSH_PRIVATE_KEY=/var/lib/gitea-runner/.ssh/id_rsa
TOFU_SSH_PUBLIC_KEY=/var/lib/gitea-runner/.ssh/id_rsa.pub

OPENSTACK_TEST_DIR=/var/lib/gitea-runner/opentofu/openstack-smoke
OPENSTACK_IMAGE_FILE=noble-qemu-okestro2018.qcow2
OPENSTACK_AUTH_URL=https://192.0.2.100:15000/v3
OPENSTACK_USERNAME=admin
OPENSTACK_PROJECT_NAME=admin
OPENSTACK_USER_DOMAIN_NAME=Default
OPENSTACK_PROJECT_DOMAIN_NAME=Default
export OS_INSECURE=true
