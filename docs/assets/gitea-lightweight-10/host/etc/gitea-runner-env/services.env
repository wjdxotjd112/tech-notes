SERVER_HOST=192.0.2.10
GITEA_HTTPS_PORT=30000
GITEA_SSH_PORT=222
NEXUS_HTTPS_PORT=55555
RELEASE_HTTPS_PORT=8443
RELEASE_MAP_FILE=/etc/haproxy/bundle-channels.map
RELEASE_SOCKET=/run/haproxy/admin.sock
TZ=Asia/Seoul

GITEA_IMAGE=gitea/gitea:1.25.4@sha256:17d18218be2dad1f8ed402a4f906989505c90ab8b66ee9befcecfb5d470133e7
POSTGRES_IMAGE=postgres:14@sha256:c2427de38f998489d36de7ca3553db2134872c400f2b08be4b824e5c50e4d619
NEXUS_IMAGE=sonatype/nexus3:3.96.1@sha256:56142f13432cf072e017aebb2025f201e42ae36ff40bb82618c702504c61f7dd
GITEA_DATA_DIR=/data/gitea/gitea-data
GITEA_DB_DATA_DIR=/data/gitea/postgres-data
GITEA_CERT_DIR=/data/gitea/certs
GITEA_DB_USER=root
GITEA_DB_NAME=gitea
NEXUS_DATA_DIR=/data/nexus/nexus-data
NEXUS_HEAP=2703m
NEXUS_DIRECT_MEMORY=2703m

MANIFEST_REPOSITORY=raw-manifest
BUNDLE_REPOSITORY=raw-release-bundle
RAW_REPOSITORY=raw-hosted
DOCKER_REPOSITORY=docker-hosted
STAGING_REPOSITORY=raw-release-staging

GITEA_REPOSITORY=platform/private-cloud-v4
RELEASE_BRANCH=master
TEST_SKIP_LABEL=release:skip-test
LEGACY_RELEASE_TAGS=""
NEXUS_USER=release-ci

BUNDLE_WORK_DIR=/data/private-release
RAW_CACHE_DIR=/data/private-release-cache/raw/sha256
IMAGE_CACHE_DIR=/data/private-release-cache/images/sha256
BUNDLE_BUILDER_DIR=/opt/gitea/bundle-builder
RELEASE_KEEP_COUNT=3

TLS_SKIP_VERIFY=true
HTTP_CONNECT_TIMEOUT=10
HTTP_RETRY_COUNT=3

TOFU_PROJECT_DIR=/var/lib/gitea-runner/opentofu/contrabass-packaging
TOFU_SSH_PRIVATE_KEY=/var/lib/gitea-runner/.ssh/id_rsa
OPENSTACK_TEST_DIR=/var/lib/gitea-runner/opentofu/openstack-smoke
OPENSTACK_IMAGE_FILE=noble-qemu-okestro2018.qcow2
OPENSTACK_AUTH_URL=https://192.0.2.100:15000/v3
OPENSTACK_USERNAME=admin
OPENSTACK_PROJECT_NAME=admin
OPENSTACK_USER_DOMAIN_NAME=Default
OPENSTACK_PROJECT_DOMAIN_NAME=Default
OS_INSECURE=true

BACKUP_HOST=release-services
STAGING_DIR=/data/release-service-backup/staging
RESTIC_REPOSITORY=sftp:backup-store:/srv/backup/release-services
RESTIC_PASSWORD_FILE=/etc/release-backup/restic-password
SERVICE_IMAGES_DIR=/opt/gitea/service-images
